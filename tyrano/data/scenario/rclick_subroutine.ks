; rclick_subroutine.ks - サブルーチン集（TyranoScript版）

*sub_layernoshow

; 全メッセージレイヤー非表示を非表示にする
[layopt layer="message0" page=fore visible=false]
[layopt layer="message1" page=fore visible=false]

; 全前景レイヤー非表示を非表示にする  
[layopt layer="0" page=fore visible=false opacity=255]
[layopt layer="1" page=fore visible=false opacity=255]
[layopt layer="2" page=fore visible=false opacity=255]
[layopt layer="3" page=fore visible=false opacity=255]
[layopt layer="4" page=fore visible=false opacity=255]

[return]